# =============================================================================
# QORA Frontend — Environment Variables
# =============================================================================
# Copy to frontend/.env and fill in values.
# Vite bakes VITE_* vars into the JavaScript bundle at build time.
# =============================================================================

# Backend API base URL.
# Leave empty for same-origin access (proxied via Vite dev server).
# In Docker or production, set to the backend's public URL.
VITE_API_BASE_URL=

# Authentication (multi-tenant-auth): the frontend carries no API key or
# token. Identity is established by WorkOS AuthKit login (/api/v1/auth/login)
# and kept in an httpOnly qora_session cookie set by the backend. There is
# nothing to configure here — see backend/.env.example for WORKOS_* settings.
